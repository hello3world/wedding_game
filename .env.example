# Wedding Party Game - Environment Variables
# Copy this file to .env and customize values

# Game Title (используется в <title> и на главной странице)
GAME_TITLE=Свадебный Переполох Касьяновых

# Game Settings
GAME_DURATION=60
COUNTDOWN_SECONDS=5

# Admin Password (change this!)
ADMIN_PASSWORD=your-secure-password-here

# Maximum Players Per Room
MAX_PLAYERS_PER_ROOM=30

# Database (optional - defaults to in-memory storage if not set)
# DATABASE_URL=postgresql://user:password@host:port/database

# Docker Compose Settings
DB_PASSWORD=wedding
DB_USER=wedding
DB_DATABASE=wedding
POSTGRES_PASSWORD=wedding
